# Leave blank for a public repository. Put a fine-grained token here locally only.
# Select ONLY your repository; Repository permissions: Contents = Read-only.
GITHUB_TOKEN=
# Optional initial settings; the browser saves subsequent choices in data/index.sqlite3.
# Either owner/repository or a pasted github.com address works here.
GITHUB_REPOSITORY=OWNER/REPOSITORY
GITHUB_BRANCH=main
OLLAMA_MODEL=qwen3:1.7b
# Optional. Naming an embedding model adds meaning-based retrieval alongside word matching,
# which helps when your question and the code share no words. Leave it blank to stay lexical.
# Install once: ollama pull nomic-embed-text. Clear the setting to disable semantic search.
# If the model is missing or Ollama is down, scans and answers carry on without it.
PKA_EMBED_MODEL=nomic-embed-text
# Fixed loopback endpoint: http://127.0.0.1:11434 . No cloud inference.

# Independent work within a job. Values are capped; 1 restores sequential processing.
PKA_READ_CONCURRENCY=4
PKA_EMBED_CONCURRENCY=2
PKA_OVERVIEW_CONCURRENCY=2
# Ollama has its own concurrency limit. OLLAMA_NUM_PARALLEL must be configured
# on the Ollama server process, not in this file. Benchmark before increasing it
# on a CPU or a machine with limited memory. No model service is restarted by the app.

# Jira: read one selected project. Keep real credentials only in your local .env.
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Slack bot-token reader is not implemented; use SLACK_USER_TOKEN below.
SLACK_BOT_TOKEN=
# Slack with your own account instead of a bot. Read-only scopes only:
# channels:history, channels:read, groups:history, groups:read. Never im:history.
SLACK_USER_TOKEN=
# Needed for the Connect Slack button. From your Slack app, Basic Information.
# Add http://localhost:8000/api/slack/callback as a Redirect URL in that app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
